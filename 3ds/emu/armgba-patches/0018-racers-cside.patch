 		videoSyncDue(gba);
 	}
 }
+void videoDispcntWritten(struct GBA*);
+// Writes video register address (an offset into the I/O space) into a batch (CSIDE_BATCH), as ioWrite with the machine's
+// copies drawing does, syncing the video first; the CPU's clock is the console's.
+static inline void renderBatchWrite(struct GBA* gba, struct RenderBatch* batch, uint32_t address, uint16_t value) {
+	if ((int32_t) (timingCpuTime(gba) - gba->video.stableUntil) >= 0) {
+		// (what the sync does may log: after what is batched)
+		renderBatchFlush(gba, batch);
+		videoSyncDue(gba);
+	}
+	uint16_t const logged = value;
+	uint16_t kept = 0;
+	if (address == batch->maskedRegister) {
+		kept = value & batch->maskedBits;
+		value &= ~batch->maskedBits;
+	}
+	value &= renderLeanMask[address >> 1];
+	if (address == 0x000) {
+		gba->renderer.dispcnt = value;
+		gba->vramStall = (value & 7) == 2 && (value & 0x0C00) == 0x0C00;
+		videoDispcntWritten(gba);
+	} else if (address == 0x054 && value > 0x10) {
+		value = 0x10;
+	}
+	gba->io[address >> 1] = value | kept;
+	uint32_t count = batch->count;
+	if (count == 2 * RENDER_BATCH_MAX) {
+		renderBatchFlush(gba, batch);
+		count = 0;
+	}
+	batch->words[count] = address << 16 | logged;
+	batch->words[count + 1] = (uint32_t) (timingCpuTime(gba) - gba->video.lineStart);
+	batch->count = count + 2;
+}
