+	CLEAR_WORD(16) CLEAR_WORD(17) CLEAR_WORD(18) CLEAR_WORD(19) CLEAR_WORD(20) CLEAR_WORD(21) CLEAR_WORD(22) CLEAR_WORD(23)
+#undef CLEAR_WORD
