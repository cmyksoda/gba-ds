+// A 32-bit write to two video registers, made on a machine whose copies draw: the copies are logged one entry for both.
+static void writeVideoRegisters(struct GBA* gba, uint32_t address, uint32_t value) {
+	if ((gbaCside & (CSIDE_LEAN_VIDEO | CSIDE_FAST_LOG)) == (CSIDE_LEAN_VIDEO | CSIDE_FAST_LOG)) {
+		renderWriteVideo32(gba, address, value);
+		return;
