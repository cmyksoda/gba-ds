+	gba->io[address >> 1] = lean ? renderWriteRegisterLean(gba, address, value & 0xFFFF) : renderWriteRegister(gba, address, value & 0xFFFF);
+	gba->io[(address >> 1) + 1] = lean ? renderWriteRegisterLean(gba, address | 2, value >> 16) : renderWriteRegister(gba, address | 2, value >> 16);
