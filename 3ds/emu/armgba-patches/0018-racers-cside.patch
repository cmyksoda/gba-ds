+// The ways the emulation thread's own work is made cheaper (gbaCside, a bit mask, each exact): with a
+// render thread, the machine's renderer keeps only what it is read for.
+extern uint32_t gbaCside;
+enum {
+	CSIDE_LEAN_VIDEO = 1,
+	// The render log's entries are written without the checks until the ring's end or the workers' progress needs them,
+	// and a 32-bit write to two video registers is one entry. Needs threadLogsLean (no publishing at each entry).
+	CSIDE_FAST_LOG = 2,
+	// With 1 and 2: the register writes of a DMA run to video registers go in the log as one entry.
+	CSIDE_BATCH = 4,
+	// The exact CPU's steps: an instruction is decoded without a call to clear it, and code is fetched from the cartridge
+	// without the region switch.
+	CSIDE_FAST_STEP = 8,
+};
