+	if (gba->renderThread && (gbaCside & (CSIDE_LEAN_VIDEO | CSIDE_FAST_LOG)) == (CSIDE_LEAN_VIDEO | CSIDE_FAST_LOG)) {
+		renderWriteVideo(gba, address, value);
+		return;
+	}
 	if (gba->renderThread) {
+		gba->io[address >> 1] = gbaCside & CSIDE_LEAN_VIDEO ? renderWriteRegisterLean(gba, address, value) : renderWriteRegister(gba, address, value);
