+// On a way out after a multiply whose carry was left (carryLazy): works it out into r9 from the
+// operands in jitScratch. The routine keeps r0, r2 and r3.
+static void emitLazyCarry(struct Jit* jit, struct Emitter* e, int carry) {
+	aMovI(e, R1, carry - 1);
+	aBl(e, jit->multiplyCarryRoutine);
+	aDpI(e, C_AL, D_BIC, false, R_FLAGS, R_FLAGS, 0x20000000);
+	aDpR(e, C_AL, D_ORR, false, R_FLAGS, R_FLAGS, R1, S_LSL, 29);
+}
+
 // Compiles a block into the current stretch: the analysis, then each instruction, then the cold code
 // the instructions left for the end (slow paths, exits and stubs). Returns false, having written
 // nothing outside the free space there, if its code didn't fit.
@@ -3110,6 +3144,9 @@ static bool compileInStretch(struct Jit* jit, struct Block* block, struct Inst*
 		struct Stub* stub = &c.stubs[i];
 		patchHere(e, stub->site);
 		stub->code = e->p;
+		if (stub->carry) {
+			emitLazyCarry(jit, e, stub->carry);
+		}
 		if (stub->pending) {
 			aAddI(e, R_CYC, R_CYC, stub->pending, R12);
 		}
@@ -3156,6 +3193,9 @@ static bool compileInStretch(struct Jit* jit, struct Block* block, struct Inst*
 		int index = c.deferred[i].index;
 		uint32_t next = c.insts[0].address + (index + 1) * c.width;
 		patchHere(e, c.deferred[i].site);
+		if (c.deferred[i].carry) {
+			emitLazyCarry(jit, e, c.deferred[i].carry);
+		}
 		aBl(e, jit->deferredStubRoutine);
 		aB(e, C_AL, block->entries[index + 1]);
 		emit32(e, next);
